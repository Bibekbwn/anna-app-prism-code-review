{
  "schema": 4,
  "required_executas": [
    { "tool_id": "tool-dev-prism-review" }
  ],
  "system_prompt_addendum": "You are PRISM Code Review, a code quality and security assistant. When the user wants to review code for security flaws, quality issues, or bugs, open the PRISM workspace via open_app_view('new'). Summarize findings with severity, file:line, and suggested fixes.",
  "tags": ["code-review", "security", "developer-tools", "quality"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html"
    },
    "views": [
      {
        "name": "new",
        "title": "New Review",
        "default": true,
        "min_size": { "w": 700, "h": 500 },
        "default_size": { "w": 1100, "h": 700 },
        "max_size": { "w": 1920, "h": 1200 },
        "resizable": true,
        "movable": true,
        "single_instance": true,
        "summary_template": "New Review"
      },
      {
        "name": "results",
        "title": "Review Results",
        "min_size": { "w": 700, "h": 500 },
        "default_size": { "w": 1100, "h": 700 },
        "max_size": { "w": 1920, "h": 1200 },
        "resizable": true,
        "movable": true,
        "single_instance": true,
        "summary_template": "Review Results"
      },
      {
        "name": "history",
        "title": "Review History",
        "min_size": { "w": 700, "h": 500 },
        "default_size": { "w": 1100, "h": 700 },
        "max_size": { "w": 1920, "h": 1200 },
        "resizable": true,
        "movable": true,
        "single_instance": true,
        "summary_template": "Review History"
      },
      {
        "name": "templates",
        "title": "Snippet Templates",
        "min_size": { "w": 700, "h": 500 },
        "default_size": { "w": 1100, "h": 700 },
        "max_size": { "w": 1920, "h": 1200 },
        "resizable": true,
        "movable": true,
        "single_instance": true,
        "summary_template": "Snippet Templates"
      },
      {
        "name": "compare",
        "title": "Code Compare",
        "min_size": { "w": 700, "h": 500 },
        "default_size": { "w": 1100, "h": 700 },
        "max_size": { "w": 1920, "h": 1200 },
        "resizable": true,
        "movable": true,
        "single_instance": true,
        "summary_template": "Code Compare"
      },
      {
        "name": "preferences",
        "title": "Preferences",
        "min_size": { "w": 600, "h": 400 },
        "default_size": { "w": 800, "h": 600 },
        "max_size": { "w": 1400, "h": 900 },
        "resizable": true,
        "movable": true,
        "single_instance": true,
        "summary_template": "Preferences"
      }
    ],
    "host_api": {},
    "browser_permissions": [],
    "csp_overrides": {}
  }
}
